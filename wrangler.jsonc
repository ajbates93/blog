{
  // Static site: `npx nuxt generate` builds into dist/, served as Workers static assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexbates-dev",
  "compatibility_date": "2026-10-01",
  // Only serve on the real domains (avoids a duplicate site on *.workers.dev)
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "alexbates.dev", "custom_domain": true },
    { "pattern": "www.alexbates.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Unknown paths get dist/404.html with a 404 status
    "not_found_handling": "404-page",
    // Serve /blog/post (no trailing slash) and redirect /blog/post/ to it
    "html_handling": "drop-trailing-slash"
  }
}
